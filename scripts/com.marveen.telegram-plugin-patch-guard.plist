<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  A Telegram plugin reply_to_message_id patch-jenek GARANTALT, felhasznaloi
  beavatkozas nelkuli fenntartasa (Jozsi, 2026-08-21 -- "ne legyen olyan,
  hogy hol mukodik hol nem, es minden fejnel mukodjon").

  A javitas maga csak nyers fajl-patch a Claude Code plugin-cache-eben --
  ha egy plugin-marketplace-frissites vagy uj-fej-onboardolas visszairja a
  pristine (patch nelkuli) tartalmat, ez a launchd-job automatikusan
  ujra-alkalmazza. FUGGETLEN attol, fut-e barmelyik Marveen-fej sessionje --
  tisztan OS-szintu, nem fogyaszt Claude-kvotat (a script maga Python,
  nincs benne modell-hivas), ugyanaz az architektura, mint a
  com.marveen.quota-watch.

  Install:
    cp scripts/com.marveen.telegram-plugin-patch-guard.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.marveen.telegram-plugin-patch-guard.plist
    launchctl kickstart -k gui/$(id -u)/com.marveen.telegram-plugin-patch-guard
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.marveen.telegram-plugin-patch-guard</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/ceo/Marveen/scripts/telegram-plugin-patch-guard.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/ceo/Marveen</string>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>1800</integer>
  <key>StandardOutPath</key>
  <string>/Users/ceo/Marveen/store/telegram-plugin-patch-guard.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/ceo/Marveen/store/telegram-plugin-patch-guard.error.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin</string>
    <key>HOME</key>
    <string>/Users/ceo</string>
  </dict>
</dict>
</plist>
