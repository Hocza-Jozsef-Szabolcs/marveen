{
  "model": "claude-haiku-4-5-20251001",
  "enabledPlugins": {
    "slack-channel@marveen-marketplace": false,
    "telegram@claude-plugins-official": true
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c '[ -f /Users/ceo/Marveen/scripts/hooks/ledger-capture.py ] && exec python3 /Users/ceo/Marveen/scripts/hooks/ledger-capture.py; exit 0'",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c '[ -f /Users/ceo/Marveen/scripts/hooks/inbox-drain.py ] && exec python3 /Users/ceo/Marveen/scripts/hooks/inbox-drain.py; exit 0'",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c '[ -f /Users/ceo/Marveen/scripts/hooks/telegram-reply-directive.py ] && exec python3 /Users/ceo/Marveen/scripts/hooks/telegram-reply-directive.py; exit 0'",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__plugin_telegram_telegram__reply",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c '[ -f /Users/ceo/Marveen/scripts/hooks/ledger-outbound.py ] && exec python3 /Users/ceo/Marveen/scripts/hooks/ledger-outbound.py; exit 0'",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c '[ -f /Users/ceo/Marveen/scripts/hooks/tool-log-capture.py ] && exec python3 /Users/ceo/Marveen/scripts/hooks/tool-log-capture.py; exit 0'",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c '[ -f /Users/ceo/Marveen/scripts/hooks/telegram-reply-guard.py ] && exec python3 /Users/ceo/Marveen/scripts/hooks/telegram-reply-guard.py; exit 0'",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c '[ -f /Users/ceo/Marveen/scripts/hooks/outgoing-copy-gate.py ] && exec python3 /Users/ceo/Marveen/scripts/hooks/outgoing-copy-gate.py; exit 0'",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": ".*send_email.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c '[ -f /Users/ceo/Marveen/scripts/hooks/outgoing-copy-gate.py ] && exec python3 /Users/ceo/Marveen/scripts/hooks/outgoing-copy-gate.py; exit 0'",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "mcp__plugin_telegram_telegram__reply",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c '[ -f /Users/ceo/Marveen/scripts/hooks/outgoing-copy-gate.py ] && exec python3 /Users/ceo/Marveen/scripts/hooks/outgoing-copy-gate.py; exit 0'",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c '[ -f /Users/ceo/Marveen/scripts/hooks/ledger-replay.py ] && exec python3 /Users/ceo/Marveen/scripts/hooks/ledger-replay.py; exit 0'",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
